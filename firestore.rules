rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Catch-All default-deny Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation Blueprint for User Profiles
    function isValidUser(data) {
      return ('userId' in data) && ('displayName' in data) && ('email' in data)
        && data.userId == request.auth.uid
        && data.displayName is string && data.displayName.size() <= 512
        && data.email is string && data.email.size() <= 512
        && (!('picture' in data) || (data.picture is string && data.picture.size() <= 8192))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 256))
        && (!('driveRootFolderId' in data) || (data.driveRootFolderId is string && data.driveRootFolderId.size() <= 256))
        && (!('driveConnectedAt' in data) || (data.driveConnectedAt is string && data.driveConnectedAt.size() <= 256))
        && (!('driveTokens' in data) || (data.driveTokens is string && data.driveTokens.size() <= 65536));
    }

    // Validation Blueprint for Chat Metadata (V3)
    function isValidChat(data) {
      return ('id' in data) && ('name' in data) && ('fileName' in data) && ('myIdentity' in data) && ('otherIdentity' in data) && ('driveFolderId' in data) && ('totalMessageCount' in data) && ('storageVersion' in data) && ('isImported' in data) && ('createdAt' in data)
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 256
        && data.fileName is string && data.fileName.size() <= 256
        && data.myIdentity is string && data.myIdentity.size() <= 256
        && data.otherIdentity is string && data.otherIdentity.size() <= 256
        && data.driveFolderId is string && data.driveFolderId.size() <= 128
        && data.totalMessageCount is int && data.totalMessageCount >= 0
        && data.storageVersion is int
        && data.isImported is bool
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    // Match blocks

    // Users namespace - completely restricted by Owner authentication
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming())
                       && (!('userId' in existing()) || existing().userId == incoming().userId)
                       && (!('email' in existing()) || existing().email == incoming().email);
      allow delete: if isOwner(userId);

      // Preserve V1 sub-collections nested under user namespace
      match /profile/{profileId} {
        allow read, write: if isOwner(userId);
      }

      match /proposals/{proposalId} {
        allow read, write: if isOwner(userId);
      }

      match /inquiries/{inquiryId} {
        allow read, write: if isOwner(userId);
      }

      // V3 Tools Chats Collection (Metadata only, messages stored in Google Drive + IndexedDB)
      match /tools_chats/{chatId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(chatId) && isValidChat(incoming());
        allow update: if isOwner(userId) && isValidId(chatId) && isValidChat(incoming())
                         && incoming().id == existing().id
                         && incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId) && isValidId(chatId);
      }
    }

    // Explicit absolute path matching for legacy SSO structures
    match /users/{userId}/proposals/{proposalId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/inquiries/{inquiryId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/profile/{profileId} {
      allow read, write: if isOwner(userId);
    }
    
    // Public contact message submissions (existing)
    match /messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Public service inquiry submissions (existing)
    match /service_inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Public bottleneck proposal submissions (existing)
    match /bottleneck_proposals/{proposalId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Root guest proposals (existing)
    match /guest_proposals/{proposalId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Root guest inquiries (existing)
    match /guest_inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
