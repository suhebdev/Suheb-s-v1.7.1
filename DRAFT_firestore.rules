rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Catch-All default-deny Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation Blueprint for User Profiles
    function isValidUser(data) {
      return data.keys().hasAll(['userId', 'displayName', 'email'])
        && data.userId == request.auth.uid
        && data.displayName is string && data.displayName.size() <= 256
        && data.email is string && data.email.size() <= 256
        && (!data.keys().contains('picture') || (data.picture is string && data.picture.size() <= 1024))
        && (!data.keys().contains('createdAt') || (data.createdAt is string && data.createdAt.size() <= 64))
        && (!data.keys().contains('driveRootFolderId') || (data.driveRootFolderId is string && data.driveRootFolderId.size() <= 128))
        && (!data.keys().contains('driveConnectedAt') || (data.driveConnectedAt is string && data.driveConnectedAt.size() <= 64))
        && (!data.keys().contains('driveTokens') || (data.driveTokens is string && data.driveTokens.size() <= 4096));
    }

    // Validation Blueprint for Chat Metadata
    function isValidChat(data) {
      return data.keys().hasAll(['id', 'name', 'fileName', 'createdAt', 'lastMessage', 'myIdentity', 'otherIdentity'])
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 256
        && data.fileName is string && data.fileName.size() <= 256
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.lastMessage is string && data.lastMessage.size() <= 1024
        && data.myIdentity is string && data.myIdentity.size() <= 256
        && data.otherIdentity is string && data.otherIdentity.size() <= 256
        && (!data.keys().contains('driveFolderId') || (data.driveFolderId is string && data.driveFolderId.size() <= 128))
        && (!data.keys().contains('date') || (data.date is string && data.date.size() <= 128));
    }

    // Validation Blueprint for Messages
    function isValidMessage(data) {
      return data.keys().hasAll(['id', 'text', 'sender', 'senderName', 'timestamp', 'type', 'sequenceIndex'])
        && data.id is string && data.id.size() <= 128
        && data.text is string && data.text.size() <= 100000
        && data.sender is string && (data.sender == 'me' || data.sender == 'other' || data.sender == 'system')
        && data.senderName is string && data.senderName.size() <= 256
        && data.timestamp is string && data.timestamp.size() <= 64
        && data.type is string && (data.type == 'text' || data.type == 'image' || data.type == 'video' || data.type == 'audio' || data.type == 'document' || data.type == 'sticker')
        && data.sequenceIndex is int
        && (!data.keys().contains('time') || (data.time is string && data.time.size() <= 64))
        && (!data.keys().contains('mediaFileName') || (data.mediaFileName is string && data.mediaFileName.size() <= 256))
        && (!data.keys().contains('caption') || (data.caption is string && data.caption.size() <= 1024))
        && (!data.keys().contains('duration') || (data.duration is string && data.duration.size() <= 64))
        && (!data.keys().contains('driveFileId') || (data.driveFileId is string && data.driveFileId.size() <= 128))
        && (!data.keys().contains('replyToMessageId') || (data.replyToMessageId is string && data.replyToMessageId.size() <= 128))
        && (!data.keys().contains('replyToSender') || (data.replyToSender is string && data.replyToSender.size() <= 256))
        && (!data.keys().contains('replyToSenderName') || (data.replyToSenderName is string && data.replyToSenderName.size() <= 256))
        && (!data.keys().contains('replyToText') || (data.replyToText is string && data.replyToText.size() <= 100000))
        && (!data.keys().contains('replyToType') || (data.replyToType is string && data.replyToType.size() <= 64))
        && (!data.keys().contains('isReply') || (data.isReply is bool))
        && (!data.keys().contains('isViewOnce') || (data.isViewOnce is bool))
        && (!data.keys().contains('viewOnceStatus') || (data.viewOnceStatus is string && (data.viewOnceStatus == 'opened' || data.viewOnceStatus == 'unopened' || data.viewOnceStatus == 'unknown')))
        && (!data.keys().contains('viewOnceMediaType') || (data.viewOnceMediaType is string && (data.viewOnceMediaType == 'image' || data.viewOnceMediaType == 'video' || data.viewOnceMediaType == 'audio' || data.viewOnceMediaType == 'document' || data.viewOnceMediaType == 'unknown')))
        && (!data.keys().contains('isMediaOmitted') || (data.isMediaOmitted is bool));
    }

    // Match blocks

    // Users namespace - completely restricted by Owner authentication
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming())
                       && incoming().userId == existing().userId
                       && incoming().email == existing().email;
      allow delete: if isOwner(userId);

      // Preserve V1 sub-collections nested under user namespace
      match /profile/{profileId} {
        allow read, write: if isOwner(userId);
      }

      match /proposals/{proposalId} {
        allow read, write: if isOwner(userId);
      }

      match /inquiries/{inquiryId} {
        allow read, write: if isOwner(userId);
      }

      // V2 Robust Subcollections
      match /tools_chats/{chatId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(chatId) && isValidChat(incoming());
        allow update: if isOwner(userId) && isValidId(chatId) && isValidChat(incoming())
                         && incoming().id == existing().id
                         && incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId) && isValidId(chatId);

        match /messages/{messageId} {
          allow read: if isOwner(userId);
          allow create: if isOwner(userId) && isValidId(messageId) && isValidMessage(incoming());
          allow update: if isOwner(userId) && isValidId(messageId) && isValidMessage(incoming())
                           && incoming().id == existing().id;
          allow delete: if isOwner(userId) && isValidId(messageId);
        }
      }
    }

    // Explicit absolute path matching for legacy SSO structures
    match /users/{userId}/proposals/{proposalId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/inquiries/{inquiryId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/profile/{profileId} {
      allow read, write: if isOwner(userId);
    }
    
    // Public contact message submissions (existing)
    match /messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Public service inquiry submissions (existing)
    match /service_inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Public bottleneck proposal submissions (existing)
    match /bottleneck_proposals/{proposalId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Root guest proposals (existing)
    match /guest_proposals/{proposalId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Root guest inquiries (existing)
    match /guest_inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
